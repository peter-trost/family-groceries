{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bash scripts/vercel.sh install",
  "buildCommand": "bash scripts/vercel.sh build",
  "outputDirectory": "app/build/web",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/((?!.*\\.\\w+$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/((?!.*\\.\\w+$).*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(index\\.html|flutter_service_worker\\.js|flutter_bootstrap\\.js|version\\.json|manifest\\.json)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
