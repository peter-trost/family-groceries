# frozen_string_literal: true

# Release lanes. docs/RELEASE.md describes the inputs and the workflow that
# runs them.
#
#   bundle exec fastlane ios certificates   once: create the App Store
#                                           certificate and profile in the
#                                           match repo
#   bundle exec fastlane ios beta           build the IPA, upload to TestFlight
#   bundle exec fastlane android internal   build the AAB, upload to the Play
#                                           internal track

opt_out_usage

require "plist"
require "shellwords"

APP_ID = "com.petertrost.familygroceries"
# fastlane runs lane code inside fastlane/ and actions in app/, so paths are
# absolute.
APP_DIR = File.expand_path("..", __dir__)

def build_number
  ENV.fetch("BUILD_NUMBER") { UI.user_error!("BUILD_NUMBER is not set") }
end

def flutter(*args)
  sh("cd #{APP_DIR.shellescape} && flutter #{args.shelljoin}")
end

platform :ios do
  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
      in_house: false
    )
  end

  desc "Create or renew the App Store certificate and profile in the match repo"
  lane :certificates do
    match(readonly: false, api_key: asc_api_key)
  end

  desc "Build the release IPA and upload it to TestFlight"
  lane :beta do
    api_key = asc_api_key
    team_id = ENV.fetch("APPLE_TEAM_ID")
    setup_ci if ENV["CI"]
    match(readonly: true, api_key: api_key, team_id: team_id)
    profile = ENV.fetch("sigh_#{APP_ID}_appstore_profile-name")

    # The project keeps automatic signing for local development; the release
    # build signs manually with what match installed.
    update_code_signing_settings(
      path: File.join(APP_DIR, "ios/Runner.xcodeproj"),
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      bundle_identifier: APP_ID,
      profile_name: profile,
      targets: ["Runner"]
    )

    export_options = File.join(APP_DIR, "build/ios/ExportOptions.plist")
    FileUtils.mkdir_p(File.dirname(export_options))
    File.write(export_options, {
      "method" => "app-store-connect",
      "destination" => "export",
      "signingStyle" => "manual",
      "teamID" => team_id,
      "signingCertificate" => "Apple Distribution",
      "provisioningProfiles" => { APP_ID => profile },
      "uploadSymbols" => true,
      "manageAppVersionAndBuildNumber" => false
    }.to_plist)

    flutter("build", "ipa", "--release", "--build-number=#{build_number}",
            "--dart-define-from-file=config/auth.json",
            "--export-options-plist=#{export_options}")

    ipa = Dir.glob(File.join(APP_DIR, "build/ios/ipa/*.ipa")).first
    UI.user_error!("no IPA under build/ios/ipa") if ipa.nil?
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      app_identifier: APP_ID,
      skip_waiting_for_build_processing: true
    )
  end
end

platform :android do
  desc "Build the release App Bundle and upload it to the Play internal track"
  lane :internal do
    flutter("build", "appbundle", "--release", "--build-number=#{build_number}",
            "--dart-define-from-file=config/auth.json")
    upload_to_play_store(
      package_name: APP_ID,
      json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
      track: "internal",
      # Play accepts only draft releases until the app has been published once.
      release_status: ENV.fetch("PLAY_RELEASE_STATUS", "completed"),
      aab: File.join(APP_DIR, "build/app/outputs/bundle/release/app-release.aab"),
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
